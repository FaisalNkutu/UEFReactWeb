    private static boolean confirmExit(String exitBusyMessage) {
        OptionPaneResponse opr = null;
        if (VCCIDashBoard.ref() != null) {
            opr = VCCIDashBoard.ref().inlineOptionPaneRequest(
                    OptionsPane.PromptType.PROMPT_YES_NO,
                    "Are you sure you want to exit?");

            if (opr.isYesSelected()) {
                // put UI on busy
                try {
                    ParadigmSwingUIDirector.jUIDirector.markBusy(exitBusyMessage, false,
                            VCCIDashBoard.jVCCIDashBoard, null,
                            0);

                    // Note if we have a MapDisplayPanel we will have an AARExercise available
                    AARExerciseData exercise = MapDisplayPanel.jMapDisplayPanel.jExerciseData;

                    // We are exiting so we will save any maps loaded into/removed from the MapDisplayPanel(AARExercise)
                    // and persist these changes in the VCCIExercise
                    if (exercise != null && !exercise.isSaved()) {
                        AARExerciseData aarEx = MapDisplayPanel.jMapDisplayPanel.jExerciseData;
                        VCCIExercise vcciEx = VCCIDashBoard.getCurrentExercise();
                        vcciEx.reconcileMaps(aarEx);
                        ExerciseIO.writeExercise(vcciEx);
                    }
                } catch (Throwable t) {
                    jL.error(t.getMessage(), t);
                }
                return true;
            }
        }
        return false;
    }

