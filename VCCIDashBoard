    // Dashboard is responsible to send out the UINotifications to the
    // subscribers after taking a look at them
    @Override
    public void processDerivedNotification(
            IUINotificationEnabled subscriber,
            UINotification notification) {
        // No super to call here as this is only called after the base class
        // has handled what it needs
        if (notification != null) {
            BTO obj = notification.getObject();
            if (obj instanceof DisplayableContent) {
                DisplayableContent dc = (DisplayableContent) obj;
                if (dc.getSourceComponentID().equals(Controller.class
                        .getCanonicalName()) &&
                        dc.getContent() instanceof ProgressStatistics) {

                    return;
                }
            }

            BrokerKey brokerKey = notification.getBrokerKey();

            if (brokerKey == null || jCurrentExercise == null) {
                return;
            }

            if (obj instanceof DisplayableMessage) {
                notifyUser((VCCIExercise) jCurrentExercise, (DisplayableMessage) obj);
                // Once a user is notified, there is nothing more that needs to be done
                return;
            }

            if (obj instanceof ClockTick) {
                setClock();
                if (jVCCIControlPanel != null) {
                    jVCCIControlPanel.sendClockTick((ClockTick) obj);
                }
            }

            if (subscriber instanceof IUINotificationEnabled) {
                if (obj instanceof ConnectionTypeNotification) {
                    ConnectionTypeNotification ctn = (ConnectionTypeNotification) obj;
                    DConnectionType dct = ctn.getConnectionType();
                    if (dct != null) {
                        DataBank.jDataBank.updateMappedObjects(dct.getMapper());
                    }
                }
                ((IUINotificationEnabled) subscriber).processNotification(obj);
            }

            notification = null;
        }
    }

