     *
     * @param si     A reference to the System Instance to which this message
     *               applies
     * @param msgObj A reference to the object containing a user message
     */
    public void notifyUser(VCCIExercise si, DisplayableMessage msgObj) {
        String msg = msgObj.getMessageText();
        notifyUser(msg, msgObj.getMessageType(), msgObj.getAlsoLog());
        if (msgObj.getCommand() == DisplayableMessage.Command.SHUTDOWN) {
            if (si != null) {
                inlineOptionPaneRequest(
                        OptionsPane.PromptType.PROMPT_OK_ERROR,
                        msg);
                si.shutdown(false);
            }
        } else if (msgObj.getCommand() == DisplayableMessage.Command.PROMPT) {
            if (si != null) {
                inlineOptionPaneRequest(
                        OptionsPane.PromptType.PROMPT_OK_INFORMATION,
                        msg);
            }
        }
    }

