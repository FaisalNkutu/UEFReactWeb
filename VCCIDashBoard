            DConnectionType connType;
            if (object instanceof DDataFlowSpecification) {
                dfs = (DDataFlowSpecification) object;
                jXMLRep = new MappingsXMLRep(dfs, super.jCurrentExercise);
            } else if (object instanceof DConnection) {
                conn = (DConnection) object;
                jXMLRep = new MappingsXMLRep(conn, super.jCurrentExercise);
            } else if (object instanceof DConnectionType) {
                connType = (DConnectionType) object;
                jXMLRep = new MappingsXMLRep(connType, super.jCurrentExercise);
            }

            if (jXMLRep != null) {
                if (jXMLRep.importMappings()) {
                    startMappingsImportProcess(object);
                }
            }
        }
    }

    public void startMappingsImportProcess(Object targetOfMappingsImport) {
        // This method will get the type candidates from the OMAdaptor
        // When that returns we send for the item candidates. Once that
        // returns we pop up the import dialog to allow use to control
        // the mapping import
        jMappingsImportObject = targetOfMappingsImport;
        jTypesRequest = null;
        jItemsRequest = null;
        // Types
        GetMappedObjectCandidatesRequest req = new GetMappedObjectCandidatesRequest(-1, -1, true,
                true, true,
                true, false);
        ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(
                this,
                super.jCurrentExercise.getBrokerKey(),
                VCCIDashBoard.class.getCanonicalName(),
                MasterOMAdaptor.class.getCanonicalName(),
                OMAdaptor.READ_TYPEMAPPINGCANDIDATES, req, true);
        ParadigmSwingUIDirector.jUIDirector.markBusy("Preparing for mappings import", false,
                VCCIDashBoard.ref(), null, -1);
    }

    private void completeMappingsImport() {
        LinkedHashMap<String, DMappedObject> types = new LinkedHashMap();
        LinkedHashMap<String, DMappedObject> items = new LinkedHashMap();
        if (jTypesRequest != null) {
            types = jTypesRequest.getMappingObjects();
        }
        if (jItemsRequest != null) {
            items = jItemsRequest.getMappingObjects();
        }

        // Now depending on the target of the mappings import - prepare the
        // data differently - this same method can be used to import mappings
        // to all targets in the exercise (dataflows/conns/conntypes) or it
        // can be used to import to a specific target
        LinkedList<DDataFlowSpecification> targetDataFlows = new LinkedList<>();
        LinkedList<DConnectionType> targetConnectionTypes = new LinkedList<>();
        LinkedList<DConnection> targetConnections = new LinkedList<>();
        Object importTarget = jMappingsImportObject;
        if (importTarget == null) {
            targetDataFlows = jVCCIControlPanel.getDataflows();
            targetConnections = jVCCIControlPanel.getConnections();
            targetConnectionTypes = jVCCIControlPanel.getConnectionTypes();
        } else if (importTarget instanceof DDataFlowSpecification) {
            targetDataFlows.add((DDataFlowSpecification) importTarget);
        } else if (importTarget instanceof DConnection) {
            targetConnections.add((DConnection) importTarget);
        } else if (importTarget instanceof DConnectionType) {
            targetConnectionTypes.add((DConnectionType) importTarget);
        }

        if (jXMLRep != null) {
            MappingImportDialog mid = new MappingImportDialog(VCCIDashBoard.ref(), this);

            mid.setImportData(super.jCurrentExercise.getBrokerKey(),
                    jXMLRep.getImportedDataflows(),
                    targetDataFlows,
                    items,
                    types,
                    jXMLRep.getImportedConnectionTypes(),
                    targetConnectionTypes,
                    jXMLRep.getImportedConnections(),
                    targetConnections);

            // Need good space here
            Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize();
            double width = screenSize.getWidth();
            double height = screenSize.getHeight();
            int h = (int) (5 * height) / 12;
            int w = (int) (5 * width) / 8;
            mid.setSize(w, h);
            GUIUtils.centerWindowOnScreen(mid);

            jMappingImportDialogActive = true;
            mid.setVisible(true);
        } else {
            ParadigmSwingUIDirector.jUIDirector.showApplicationErrorMessage(
                    "Unable to import mappings!");
        }
    }

    public void onImportKmlKmz(ImportKmlRequestNotification request) {
        ClockTick tick = jCurrentExercise.getClockTick();
        long currentTime = tick == null ? DBConstants.INVALID_TIME : tick.getClock();
        long simOffSetTime = tick == null ? DBConstants.INVALID_TIME : tick.getSimulationOffsetTime();

        Optional.ofNullable(request.getFileName())
                .map(fileName -> {
                    jPendingImportKmlRequestNotification = request;
                    return new File(fileName);
                })
                .or(KMLUtilities::importFileChooserMaybe)
                .ifPresent(importFile -> {
                    KMLImport kmlImport = new KMLImport(getCursitPanel().getDBWriter(), importFile,
                            currentTime, simOffSetTime, this);

                    kmlImport.start();
                });
    }

    public void onExportToKmz(ExportKmlRequestNotification request) {
        Optional.ofNullable(request.getFileName())
                .map(fileName -> {
                    jPendingExportKmlRequestNotification = request;
                    return new File(fileName);
