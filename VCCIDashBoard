    @Override
    public void importComplete(KMLImportResponse response) {
        if (jPendingImportKmlRequestNotification != null) {
            // Send a KmlImportedNotification as a response to the ImportKmlRequestNotification.
            // This is likely going to wringer (VCCI does not subscribe to this).
            KmlImportedNotification notification = new KmlImportedNotification(
                    response.getFilename(), response.getMessage(), response.isError());
            ParadigmSwingUIDirector.jUIDirector.getUIComponent().publishObject(
                    KmlImportedNotification.class, notification, false);
            jPendingImportKmlRequestNotification = null;
        } else if (VCCIDashBoard.jVCCIDashBoard != null) {
            handleKmlCompletePrompt(response.getMessage(), response.isError());
        }
    }

    @Override
    public void exportComplete(KMLExportResponse response) {
        if (jPendingExportKmlRequestNotification != null) {
            // Send a KmlExportedNotification as a response to the ExportKmlRequestNotification.
            // This is likely going to wringer (VCCI does not subscribe to this).
            KmlExportedNotification notification = new KmlExportedNotification(
                    response.getFile().getAbsolutePath(),
                    response.getMessage(),
                    response.getError());
            ParadigmSwingUIDirector.jUIDirector.getUIComponent().publishObject(
                    KmlExportedNotification.class, notification, false);
            jPendingExportKmlRequestNotification = null;
        } else if (VCCIDashBoard.jVCCIDashBoard != null) {
            handleKmlCompletePrompt(response.getMessage(), response.getError());
        }
    }

    private void handleKmlCompletePrompt(String message, boolean error) {
        OptionsPane.PromptType promptType;
        if (error) {
            promptType = OptionsPane.PromptType.PROMPT_OK_ERROR;
        } else {
            promptType = OptionsPane.PromptType.PROMPT_OK_INFORMATION;
        }
        VCCIDashBoard.jVCCIDashBoard.optionPaneRequest(promptType, message);
    }

