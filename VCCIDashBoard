    public final void runRedHostCheck() {
        // See if the red host contains one of our local IPs
        String gateway = REDServer.getREDHostName();
        if (gateway == null) {
            JOptionPane.showMessageDialog(null, "Unable to determine host name.",
                    "VCCI Network Interface Error",
                    JOptionPane.ERROR_MESSAGE);
            return;
        }
        try {
            InetAddress address = InetAddress.getByName(gateway);
            String hostAddress = address.getHostAddress();
            // Make sure this is in a local address
            if (!jValidLocalIPs.contains(hostAddress)) {
                String warning = "The Configured VCCI Network interface [" + hostAddress +"] is no longer valid." +
                        "\nClose VCCI and edit C:\\Program Files\\SimToolSuite\\vcci\\config\\red_host_info.txt and update the IP address within the file. " +
                        "\nPress OK or close this dialog to shutdown VCCI";
                JOptionPane.showMessageDialog(null, warning, "VCCI Network Interface Error",
                        JOptionPane.WARNING_MESSAGE);
                System.exit(1);
            }
        } catch (UnknownHostException ex) {
            jL.error(ex.getMessage(), ex);
        }
    }

    public static String indicatorToString(Indicator indicator) {
        if (indicator == null) {
            return "UNKNOWN";
        }

        switch (indicator) {
            case INITIALIZING:
            case WARNING:
            case WARNING_FLASH: {
                return "WARNING";
            }
            case NORMAL:
                return "NORMAL";

            case STOPPED:
            case ERROR:
            case ALARM:
                return "ERROR";

            case UNKNOWN:
            default: {
                return "UNKNOWN";
            }
        }
    }

    /**
     * This method will determine the set of VCCI Servers that can be used
     *
     * @return A collection of valid VCCI RED Client objects (1 fr each VCCI
     * Server)
     */
    public static LinkedHashMap<String, REDClient> getRemoteIPAddresses() {
        return getRemoteIPAddresses(null);
    }

    public static LinkedHashMap<String, REDClient> getRemoteIPAddresses(String hostip) {
        // Try to determine all Remote VCCI Servers that exist
        LinkedList<REDClient> clients = REDClient.getREDClients(2000, hostip);
        LinkedHashMap<String, REDClient> vcciRedClients = new LinkedHashMap<>();

        for (REDClient redClient : clients) {
            vcciRedClients.put(redClient.getREDInetAddress().getHostAddress(), redClient);
        }
        return vcciRedClients;
    }

    public static boolean backup(
            boolean useRED,
            String hostname,
            String dbName,
            String user,
            String pwd) {
        if (useRED) {
            LinkedHashMap<String, REDClient> reds = jVCCIRedClients;
            REDClient redClient = reds.get(hostname);
            if (redClient != null) {
                try {

                    if (!redClient.connect()) {
                        return false;
                    }
                    String filename =
                            dbName + "_" + (new DateTime().getDateTimeAsString()) + ".vbk";
                    File parent = LocalData.getLocalDataFolder("omdb_backup").toFile();
                    if (!parent.exists()) {
                        parent.mkdirs();
                    }
                    redClient.sendBackupMySQLDB(new File(parent, filename), user, pwd, hostname,
                            dbName, true);
                    return true;
                } catch (IOException ex) {
                    //This is thrown if the command was unsuccessful.
                    jL.error(ex.getMessage(), ex);
                    return false;
                }
            }
            return false;
        } else {
            return AutoBackup.backupOMDB(hostname, dbName, user, pwd,
                    ParadigmSwingUIDirector.jUIDirector.getUIComponent(),
                    false);
        }
    }

