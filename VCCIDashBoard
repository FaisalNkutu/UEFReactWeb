    // Add rules for allowing multiple dataflows of any sort
    @Override
    public boolean allowsMultipleDataflows(
            DSystemCapability capability,
            DConnection conn) {
        // No multiple dataflows allowed
        if (Constants.CA_DATA_FILL.equals(capability.getSystemCapabilityName())
                && DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_IN.equals(
                capability.getSystemCapabilityCategoryCode())) {
            for (DDataFlowSpecification dfs : jVCCIControlPanel.getDataflows()) {
                if ((dfs.getConnection().getConnectionName().equals(Constants.CT_ABACUS_V35))
                        && dfs.getSystemCapability().getSystemCapabilityName().equals(
                        Constants.CA_DATA_FILL)
                        && dfs.getSystemCapability().getSystemCapabilityCategoryCode().equals(
                        DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_IN)) {
                    return false;
                }
            }
            return true;
        }
        if (Constants.CA_CONTROL_FEATURE.equals(capability.getSystemCapabilityName())
                && DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_OUT.equals(
                capability.getSystemCapabilityCategoryCode())) {
            for (DDataFlowSpecification dfs : jVCCIControlPanel.getDataflows()) {
                if ((dfs.getConnection().getConnectionName().equals(Constants.CT_ABACUS_V35))
                        && dfs.getSystemCapability().getSystemCapabilityName().equals(
                        Constants.CA_CONTROL_FEATURE)
                        && dfs.getSystemCapability().getSystemCapabilityCategoryCode().equals(
                        DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_OUT)) {
                    return false;
                }
            }
            return true;
        }
        if (Constants.CA_SA.equals(capability.getSystemCapabilityName())
                && DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_OUT.equals(
                capability.getSystemCapabilityCategoryCode())) {
            for (DDataFlowSpecification dfs : jVCCIControlPanel.getDataflows()) {
                if ((dfs.getConnection().getConnectionName().equals(Constants.CT_ABACUS_V35))
                        && dfs.getSystemCapability().getSystemCapabilityName().equals(Constants.CA_SA)
                        && dfs.getSystemCapability().getSystemCapabilityCategoryCode().equals(
                        DSystemCapability.SYSTEM_CAPABILITY_CATEGORY_CODE_OUT)) {
                    return false;
                }
            }
            return true;
        }
        return false;
    }

