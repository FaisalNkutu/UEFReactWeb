    private void configure() {
        jL.info("Task 3 of 4 - Initializing CURSIT");
        long taskStartMillis = System.currentTimeMillis();
        activateCursit();
        jL.info("Task 3 Complete in {} milliseconds", System.currentTimeMillis() - taskStartMillis);

        jL.info("Task 4 of 4 - Loading Exercise Panel");
        taskStartMillis = System.currentTimeMillis();
        if (jIncludeCursit) {
            try {
                // Initially we show the CURSIT panel (First Tab)
                resetCURSITPanel();
                // Second Tab
                jDashBoardContentPanel.getAdminTabPanel().add(jAdminPanel, BorderLayout.CENTER);
                // Third Tab
                jDashBoardContentPanel.getSysViewTabPanel().add(jSystemView, BorderLayout.CENTER);
                //
            } catch (Throwable ex) {
                jL.error(ex.getMessage(), ex);
            }
        }
        jL.info("Task 4 Complete in {} milliseconds", System.currentTimeMillis() - taskStartMillis);

        try {
            jDashBoardContentPanel.jNorthPanel.setVisible(true);
            jDashBoardContentPanel.jTBWestPanel.add(jToolBarControl, BorderLayout.CENTER);
            jDashBoardContentPanel.jVCCILogoLabel.setIcon(
                    STSIcons.jApp_VCCI56x56_WithText_LightIcon);

            // Now layout our custom components
            jDashBoardContentPanel.jStatusPanelParent.add(getStatusBar(), BorderLayout.CENTER);
            jDashBoardContentPanel.jLeftPanel.add(jLeftSidePanelsManager, BorderLayout.CENTER);

            Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize();
            double width = screenSize.getWidth();
            double height = screenSize.getHeight();
            int dashBoardHeight = (int) (3 * height) / 4;
            int dashBoardWidth = (int) (13 * width) / 16;

            jLeftSidePanelsManager.setRightContent(jVCCIControlPanelCarrier);
            // On resize give more space to the data flow panel (bottom)
            jLeftSidePanelsManager.setResizeWeight(0.0);
            //jLeftSidePanelsManager.setDividerLocation((2 * dashBoardHeight) / 3);
            //jLeftSidePanelsManager.setLeftContent(jAddFolderPanelCarrier);
            jLeftSidePanelsManager.setLeftDismissed(true);

            setSize(dashBoardWidth, dashBoardHeight);
            jDashBoardContentPanel.jMainSplitPane.setDividerLocation(dashBoardWidth / 4);
            configureUIForRole();
        } catch (Throwable ex) {
            jL.error("Error Initializing ....", ex);
        }
    }

