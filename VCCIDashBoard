    // --- IFRREnabled
    @Override
    public void processResponse(FeatureRequestResponse frr) {
        ParadigmSwingUIDirector.jUIDirector.clearBusy();
        if (ParadigmSwingUIDirector.jUIDirector.getUIComponent().processError(frr, false, true)) {
            String msgStr = String.format(
                    "Feature request : %s did not get successfully executed. State : %s",
                    frr.getDstComponentID() + ":" + frr.getComponentFeatureID(),
                    frr.getStateString());
            ParadigmSwingUIDirector.jUIDirector.showApplicationErrorMessage(msgStr);
            return;
        }

        BTO result = frr.getFeatureResult();
        if (result instanceof GetMappedObjectCandidatesRequest) {
            if (jTypesRequest == null) {
                // Just got the types request back
                jTypesRequest = (GetMappedObjectCandidatesRequest) result;

                // Now send request for instances
                GetMappedObjectCandidatesRequest req = new GetMappedObjectCandidatesRequest(-1, -1,
                        true,
                        true,
                        true,
                        true,
                        false);
                ParadigmSwingUIDirector.jUIDirector.issueFeatureRequest(
                        this,
                        super.jCurrentExercise.getBrokerKey(),
                        VCCIDashBoard.class.getCanonicalName(),
                        MasterOMAdaptor.class.getCanonicalName(),
                        OMAdaptor.READ_ITEMMAPPINGCANDIDATES, req, true);
                ParadigmSwingUIDirector.jUIDirector.markBusy("Preparing for mappings import", false,
                        VCCIDashBoard.ref(), null, -1);
            } else {
                jItemsRequest = (GetMappedObjectCandidatesRequest) result;
                completeMappingsImport();
            }
        }
        if (result instanceof GetAutoBackupParameterRequest) {
            AutoBackupDialog dialog = new AutoBackupDialog(this,
                    ((GetAutoBackupParameterRequest) result).jParameters);
            dialog.setVisible(true);
        }
    }

