    private void setFirstTabContent(JPanel panel) {
        SwingUtilities.invokeLater(() -> {
            JPanel cursitTabPanel = jDashBoardContentPanel.getCURSITTabPanel();
            if (panel instanceof VCCICursitQuad) {
                int numberOfChildrenComponents = cursitTabPanel.getComponentCount();
                if (numberOfChildrenComponents == 2) {
                    jVCCICursitQuad.getCursitPanel().getMapDisplayPanel().jMapDisplay.setMapFocus(true);
                    try {
                        cursitTabPanel.remove(1);
                    } catch (NullPointerException e) {
                        jL.warn("JCEF browser has already been disposed.");
                    }
                    jVCCICursitQuad.setVisible(true);
                } else if (numberOfChildrenComponents == 0) {
                    cursitTabPanel.add(jVCCICursitQuad);
                    jVCCICursitQuad.setVisible(true);
                }
            } else {
                jVCCICursitQuad.getCursitPanel().getMapDisplayPanel().jMapDisplay.setMapFocus(false);
                jVCCICursitQuad.setVisible(false);
                cursitTabPanel.add(panel);
                panel.setVisible(true);
            }
        });
    }

