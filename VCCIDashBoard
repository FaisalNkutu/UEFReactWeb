        }
    }

    private void maybeEnableUIInteractionLogging() {
        try {
            Toolkit.getDefaultToolkit().addAWTEventListener(event -> {
                if (event instanceof MouseEvent) {
                    MouseEvent evt = (MouseEvent) event;
                    if (evt.isAltDown() && evt.getID() == MouseEvent.MOUSE_ENTERED) {
                        if (evt.getComponent() != null && evt.getComponent().getName() != null) {
                            jL.info("{} {}", evt.getComponent().getName(),
                                    evt.getLocationOnScreen().toString());
                        }
                    }
                }
            }, AWTEvent.MOUSE_EVENT_MASK);
        } catch (Throwable ignored) {
        }
    }

