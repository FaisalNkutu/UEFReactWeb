            activateServerMonitoring();
        }

        // So we can keep our cache of contexts
        ParadigmSwingUIDirector.jUIDirector.subscribeToObjectNotification(this, GContext.class);

        // To detect invalid network adaptors in DB
        ParadigmSwingUIDirector.jUIDirector.subscribeToObjectNotification(this, InvalidNetworkAdaptorsCarrier.class);

        // To update the data bank
        ParadigmSwingUIDirector.jUIDirector.subscribeToObjectNotification(this, ObjectItemCreateNotification.class);
        ParadigmSwingUIDirector.jUIDirector.subscribeToObjectNotification(this, DMetricsTimeFormats.class);

        getContentAreaForDerivedClass().add(jDashBoardContentPanel, BorderLayout.CENTER);
        setName("vcciDashBoardFrame");
        maybeEnableUIInteractionLogging();
        createTrayIcon();
        this.toFront();
    }

    private void createTrayIcon() {
        if (!SystemTray.isSupported()) {
            jL.warn("System tray is not supported!");
            return;
        }
        SystemTray systemTray = SystemTray.getSystemTray();
        Image image = Toolkit.getDefaultToolkit().getImage(
                VcciMain.class.getResource("vccinew.png"));
        //popupmenu
        PopupMenu trayPopupMenu = new PopupMenu();
        // About
        MenuItem aboutMenuItem = new MenuItem("About VCCI");
        aboutMenuItem.addActionListener(e -> {
            this.showAboutBox();
        });
        trayPopupMenu.add(aboutMenuItem);
        // Logs
        MenuItem logMenuItem = new MenuItem("Open Logs");
        logMenuItem.addActionListener(e -> {
            try {
                Path p = FileUtils.getLatestFileInFolder(LocalData.getLocalDataFolder("vcci", "logs"));
                if (p == null) {
                    throw new FileNotFoundException("Unable to locate VCCI log file");
                } else {
                    File file = p.toFile();
                    if (file.exists()) {
                        Desktop.getDesktop().open(file);
                    }
                }
            } catch (Exception ex) {
                jL.error("Failed to open log file.");
                JOptionPane.showMessageDialog(
                        this,
                        "Could not locate log file.",
                        "Error",
                        JOptionPane.ERROR_MESSAGE);
            }
        });
        trayPopupMenu.add(logMenuItem);
        // Shutdown
        MenuItem closeMenuItem = new MenuItem("Shutdown VCCI");
        closeMenuItem.addActionListener(e -> {
            VCCIDashBoard.onExit();
        });
        trayPopupMenu.add(closeMenuItem);
        //setting tray icon
        jTrayIcon = new TrayIcon(image, "VCCI", trayPopupMenu);
        //adjust to default size as per system recommendation
        jTrayIcon.setImageAutoSize(true);
        try {
            systemTray.add(jTrayIcon);
        } catch (AWTException ex) {
            jL.error(ex.getMessage(), ex);
        }
    }

    public void sendTrayIconMessage(String message, TrayIcon.MessageType messageType) {
