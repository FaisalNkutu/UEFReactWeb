    @Override
    public void doublePanelManagerShuffleNotification(DoublePanelManager manager) {
        if (manager == jLeftSidePanelsManager) {
            boolean leftVisible = manager.isLeftVisible() && !manager.isLeftMinimized();
            boolean rightVisible = manager.isRightVisible() && !manager.isRightMinimized();

            // If both panels on the left side are invisible we get rid of the
