    /// ------------------ VCCIExercise Actions
    @Override
    // Method is called periodically by the base class while the busy
    // dialog is in display. Here we check if all the requests that we need for
    // this exercise have been received yet or not. Once received the exercise
    // load is complete and the base class will bring down the busy dialog.
    protected boolean isDerivedClassReady() {
        boolean allRequestIn = ((jGetFoldersRequest != null)
                && (jGetSystemCapabilitysRequest != null)
                && (jGetDataFlowsRequest != null)
                && (jGetConnectionTypesRequest != null)
                && (jGetContextRequest != null)
                && (jGetObjectItemsRequest != null)
                && (jGetObjectTypesRequest != null)
                && (jGetNetworkAdaptorsRequest != null));

        String requestStatus =
                " jGetFoldersRequest=" + (jGetFoldersRequest == null ? " null" : " received")
                        + " jGetSystemCapabilitysRequest=" +
                        (jGetSystemCapabilitysRequest == null ? " null" : " received")
                        + " jGetDataFlowSpecificationsRequest=" +
                        (jGetDataFlowsRequest == null ? "null" : " received")
                        + " jGetConnectionTypesRequest=" +
                        (jGetConnectionTypesRequest == null ? " null" : " received")
                        + " jGetContextRequest=" + (jGetContextRequest == null ? " null" : " received")
                        + " jGetObjectItemsRequest=" +
                        (jGetObjectItemsRequest == null ? " null" : " received")
                        + " jGetObjectTypesRequest=" +
                        (jGetObjectTypesRequest == null ? " null" : " received")
                        + " jGetNetworkAdaptorsRequest=" +
                        (jGetNetworkAdaptorsRequest == null ? " null" : " received");
        UIAudit.audit("isDerivedClassReady:"
                + requestStatus, UIAudit.EXERCISE_CONNECTION);

        if (allRequestIn) {
            // UIDirector.uiPerformanceMonitor("Derived - all requests are in ... processing request data...");
            LinkedList<DConnectionType> connTypes = jGetConnectionTypesRequest.getConnectionTypes();
            jVCCIControlPanel.setConnectionTypes(connTypes);
            jVCCIControlPanel.resetSystemCapabilities(jGetSystemCapabilitysRequest);
            jVCCICursitPanel.getVCCIMapDisplayPanel().setContextIds(jGetContextRequest);
            if (DataBank.jDataBank != null) {
                DataBank.jDataBank.processObjectItems(jGetObjectItemsRequest);
                DataBank.jDataBank.processObjectTypes(jGetObjectTypesRequest);
                DataBank.jDataBank.processContexts(jGetContextRequest);
            }
            jVCCIControlPanel.resetFoldersAndDataFlows(jGetFoldersRequest, jGetDataFlowsRequest);
            getUIManager().enableControls(true);
            getUIManager().sensitizeUI(((VCCIExercise) super.jCurrentExercise).getSystemState());
            jExerciseLoadInProgress = false;
            // UIDirector.uiPerformanceMonitor("Derived - done all data processing - switch is done...");
            // Last bit of dashboard configuration

            // Make dashboard visible
            setDashboardVisible(true);
            jVCCICursitPanel.requestMovementCapabilityDataFlows();

            // Allow control panel to send request
            jStatusBar.sendTimeFormatsRequest();
            return true;
        }
        return false;
    }

