            ArrayList<AgentCard> availableAgents,
            LLMService llmService,
            ClientBoard cb) {

        //TODO: WHAT DO WE PASS IN HERE
        super(clientID.toString());
        jClientID = clientID;
        //this constructor is only called if there is a client id which means it is a registered user - persist data
        jPersistData = true;
        jResponseListener = listener;
        jCommandDependency = commandDepMap;
        jCommandToAgentList = commandMap;
        jAgentURLHashmap = urlMap;
        jAvailableAgents = availableAgents;
        jLLMService = llmService;
        jClientMetricsBoard = cb;
        initCA();
    }

