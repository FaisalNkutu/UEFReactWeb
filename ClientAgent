    public static Logger jL = Log.getLogger(ClientAgent.class);
    public UUID jClientID = null;
    private boolean jPersistData = false;
    private IResponseListener jResponseListener = null;
    //agent name to url
    private final ConcurrentHashMap<String, String> jAgentURLHashmap;
    private final ConcurrentHashMap<UUID, DataTransferObject> jActiveRequests = new ConcurrentHashMap<>();
    private final ConcurrentHashMap<UUID, ArrayList<CACommandObject>> jPendingCommands = new ConcurrentHashMap<>();
    private final ExecutorService jCommandExecutor = Executors.newSingleThreadExecutor();
    private final LinkedBlockingQueue<CACommandObject> jCommandQueue = new LinkedBlockingQueue<>(1000);
    private final ConcurrentHashMap<String, List<String>> jCommandToAgentList;
    private final ArrayList<AgentCard> jAvailableAgents;

    private final ExecutorService jLLMExecutor = Executors.newSingleThreadExecutor();
    private final LinkedBlockingQueue<UserRequest> jLLMQueue = new LinkedBlockingQueue<>(1000);
    private final ConcurrentHashMap<String, ConcurrentHashMap<String, List<String>>> jCommandDependency;

    LLMService jLLMService;
    private final Semaphore jCommandSemaphore = new Semaphore(10, true);
    private ClientConfig jClientConfig;
    HashMap<UUID, UserRequest> jHistory = new HashMap<>();
    public final ClientBoard jClientMetricsBoard;


    public ClientAgent(
            UUID clientID,
            IResponseListener listener,
            ConcurrentHashMap<String, ConcurrentHashMap<String, List<String>>> commandDepMap,
